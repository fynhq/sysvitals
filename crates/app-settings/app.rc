#pragma code_page(65001)

1 ICON "../app-win/assets/icon.ico"

1 VERSIONINFO
 FILEVERSION APP_MAJOR, APP_MINOR, APP_PATCH, 0
 PRODUCTVERSION APP_MAJOR, APP_MINOR, APP_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "SysVitals Settings"
            VALUE "FileVersion", APP_VERSION
            VALUE "LegalCopyright", "MIT License"
            VALUE "ProductName", "SysVitals"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 0x04b0
    END
END
